# Copy to .env (cp .env.example .env), then replace every CHANGE_ME.
# Generate strong values with:  openssl rand -base64 33 | tr -d '/+=' | cut -c1-32
# Passwords: 16-128 chars of A-Z a-z 0-9 _ . @ % + = -   (db/init/03_users.sh rejects anything else)
# NEVER commit .env.

MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password_32chars
MYSQL_DATABASE=hud

# Admin pages (table read/write, no DDL)
HUD_RW_USER=hud_rw
HUD_RW_PASSWORD=CHANGE_ME_rw_password_32chars

# Public HUD + /api/feed.cfm (SELECT on public views only)
HUD_RO_USER=hud_ro
HUD_RO_PASSWORD=CHANGE_ME_ro_password_32chars

# /admin password. Leave empty to disable admin entirely. Minimum 12 characters.
HUD_ADMIN_PASSWORD=

# App port mapping. Without Caddy: 0.0.0.0 / 80. With Caddy: 127.0.0.1 / 8080.
HUD_BIND=0.0.0.0
HUD_HTTP_PORT=80

# Set all three to true once Caddy/HTTPS is in front.
HUD_COOKIE_SECURE=false
HUD_TRUST_PROXY=false
HUD_HSTS=false

# Caddy (only with: docker compose --profile https up -d)
HUD_DOMAIN=hud.example.com
HUD_ACME_EMAIL=you@example.com

# API: requests per client IP per minute
HUD_API_RATE_PER_MIN=60
# Extra exact CORS origins beyond https://*.blogspot.com, comma separated (e.g. a Blogger custom domain). Empty = none.
HUD_CORS_EXTRA_ORIGINS=

HUD_SITE_TITLE=ARCHIVE//HUD
